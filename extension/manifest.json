{
    "manifest_version": 3,
    "name": "Search Lens", 
    "version": "0.0.2",
    "description": "A transparent search analysis tool that gives users more control over search results.",
    "content_script": [
      {
            "matches": [
                "https://yandex.ru/*"
        ],
        "js": [
            "src/content.js"
        ]
      }
    ],
    "action": {
        "default_title": "Search Lens"
    }
}